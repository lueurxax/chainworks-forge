{
  "$id": "https://chainworks.local/schemas/mcp/p083/p083.rollback_execution.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caller_request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "reason": {
      "maxLength": 2048,
      "type": "string"
    },
    "target_enforcement_mode": {
      "enum": [
        "permissive",
        "disabled"
      ],
      "type": "string"
    }
  },
  "required": [
    "target_enforcement_mode",
    "caller_request_id"
  ],
  "title": "p083.rollback_execution input",
  "type": "object"
}
