{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider_session_attach_receipt_v2.schema.json",
  "title": "provider_session_attach_receipt_v2",
  "description": "P086: Durable attach receipt persisted by the engine before any provider_session_resurrection continuation prompt is sent. Raw fields (requested/actual provider_session_id, adapter_runtime_home_realpath/dev_ino, managed_child_pid/pgid/start_time, identity_proof_artifact_id) are engine-internal, stored in the daemon-private engine-private/receipts path, and exposed only through the audited Operator-scoped MCP raw-read path. The provider-visible CHAINWORKS_META_ROOT copy is schema-valid but redacted. Observer/reviewer projections omit Operator-only fields rather than null-setting them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "continuation_id",
    "agent_execution_id",
    "run_id",
    "requested_provider_session_id",
    "actual_provider_session_id",
    "identity_proof_source",
    "identity_proof_observed_at",
    "identity_proof_artifact_id",
    "adapter_id",
    "adapter_capability_version",
    "attach_request_id",
    "managed_child_pid",
    "managed_process_group_id",
    "managed_child_start_time",
    "adapter_runtime_home_realpath",
    "adapter_runtime_home_dev_ino",
    "process_started_at",
    "attach_started_at",
    "attach_completed_at",
    "prompt_sent_at",
    "resurrection_phase",
    "orphan_reap_required",
    "orphan_reap_verified",
    "output_only",
    "source_edit_allowance",
    "changed_source_files_count",
    "failure_class",
    "resurrection_deadline_at",
    "resurrection_last_heartbeat_at",
    "resurrection_timeout_class",
    "timeout_settled_at"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "continuation_id": { "type": "string" },
    "agent_execution_id": { "type": "string" },
    "run_id": { "type": "string" },
    "requested_provider_session_id": { "type": ["string", "null"] },
    "actual_provider_session_id": { "type": ["string", "null"] },
    "identity_proof_source": {
      "type": ["string", "null"],
      "enum": ["provider_attach_response", "provider_session_readback", null]
    },
    "identity_proof_observed_at": { "type": ["string", "null"], "format": "date-time" },
    "identity_proof_artifact_id": { "type": ["string", "null"] },
    "adapter_id": { "type": "string" },
    "adapter_capability_version": { "type": "integer", "minimum": 1 },
    "attach_request_id": { "type": "string" },
    "managed_child_pid": { "type": ["integer", "null"] },
    "managed_process_group_id": { "type": ["integer", "null"] },
    "managed_child_start_time": { "type": ["string", "null"], "format": "date-time" },
    "adapter_runtime_home_realpath": { "type": ["string", "null"] },
    "adapter_runtime_home_dev_ino": { "type": ["string", "null"] },
    "process_started_at": { "type": ["string", "null"], "format": "date-time" },
    "attach_started_at": { "type": ["string", "null"], "format": "date-time" },
    "attach_completed_at": { "type": ["string", "null"], "format": "date-time" },
    "prompt_sent_at": { "type": ["string", "null"], "format": "date-time" },
    "resurrection_phase": {
      "type": "string",
      "enum": [
        "admitted",
        "launching",
        "launched",
        "attaching",
        "attached_unprompted",
        "prompting",
        "settling",
        "cancelling",
        "completed",
        "failed_closed"
      ]
    },
    "orphan_reap_required": { "type": "boolean" },
    "orphan_reap_verified": { "type": "boolean" },
    "output_only": { "type": "boolean" },
    "source_edit_allowance": { "type": "boolean" },
    "changed_source_files_count": { "type": "integer", "minimum": 0 },
    "changed_source_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit list of source files changed during the continuation, recorded when source_edit_allowance=true. Present only on post-execution receipt updates; absent (not null) when source edits were not allowed."
    },
    "failure_class": {
      "type": ["string", "null"],
      "enum": [
        "unsupported",
        "provider_rejected",
        "expired_or_missing_session",
        "actual_session_mismatch",
        "identity_unverifiable",
        "quota_hold",
        "auth_failure",
        "launch_failed",
        "orphan_reap_failed",
        "attach_receipt_persist_failed",
        "lease_conflict",
        "snapshot_failure",
        null
      ]
    },
    "resurrection_deadline_at": { "type": ["string", "null"], "format": "date-time" },
    "resurrection_last_heartbeat_at": { "type": ["string", "null"], "format": "date-time" },
    "resurrection_timeout_class": {
      "type": ["string", "null"],
      "enum": [
        "dequeue_timeout",
        "launch_timeout",
        "attach_timeout",
        "unprompted_timeout",
        "prompt_timeout",
        "settle_timeout",
        "cancel_timeout",
        null
      ]
    },
    "timeout_settled_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
