{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuation_result_v1.schema.json",
  "title": "continuation_result_v1",
  "description": "P086: Result artifact written on succeeded terminal status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind",
    "run_id", "stage_execution_id", "agent_execution_id", "continuation_id",
    "created_at", "redaction_tier", "retention_policy", "payload"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "continuation_result_v1"},
    "artifact_kind": {"type": "string", "const": "continuation_result"},
    "run_id": {"type": "string"},
    "stage_execution_id": {"type": "string"},
    "agent_execution_id": {"type": "string"},
    "continuation_id": {"type": "string"},
    "created_at": {"type": "string"},
    "redaction_tier": {"type": "string", "enum": ["none", "partial", "full"]},
    "retention_policy": {"type": "string"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary", "changed_files", "tests_or_gates",
        "response_fingerprint_sha256", "provider_transcript_artifact_ids"
      ],
      "properties": {
        "summary": {"type": "string"},
        "changed_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "tests_or_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string"},
              "status": {"type": "string"},
              "detail": {"type": "string"}
            }
          }
        },
        "response_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider_transcript_artifact_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
