{
  "schema_version": "p031-thin-ui-inventory-v1",
  "status": "ready",
  "governed_surfaces": [
    {
      "file_path": "Chainworks Forge/Views/RunsHomeView.swift",
      "description": "Primary landing surface with run list and freshness rendering"
    },
    {
      "file_path": "Chainworks Forge/Views/StageDetailView.swift",
      "description": "Stage-level execution readback and decision flags"
    },
    {
      "file_path": "Chainworks Forge/Views/ApprovalGateView.swift",
      "description": "Read-only approval inbox and diagnostic guidance"
    },
    {
      "file_path": "Chainworks Forge/Views/ArtifactInspectorView.swift",
      "description": "Read-only artifact content and provenance display"
    },
    {
      "file_path": "Chainworks Forge/Views/RunArtifactHierarchyView.swift",
      "description": "Hierarchical browsing of run-scoped artifacts"
    },
    {
      "file_path": "Chainworks Forge/Views/RunReportView.swift",
      "description": "Metadata-only report inspection with payload availability indicators"
    },
    {
      "file_path": "Chainworks Forge/Views/BlockedRunRecoveryView.swift",
      "description": "Diagnostic guidance for blocked runs and workflow conflicts"
    },
    {
      "file_path": "Chainworks Forge/Views/RecoverySheet.swift",
      "description": "Inline diagnostic identifiers for external write workflows"
    },
    {
      "file_path": "Chainworks Forge/Views/RunComparisonView.swift",
      "description": "Read-only comparison of structural run truth"
    },
    {
      "file_path": "Chainworks Forge/Views/WorkflowInspectorView.swift",
      "description": "Read-only inspection of compiled workflow plans"
    },
    {
      "file_path": "Chainworks Forge/Views/WorkflowMapView.swift",
      "description": "Read-only topology and agent activity visualization"
    },
    {
      "file_path": "Chainworks Forge/Views/DaemonLifecycleSurface.swift",
      "description": "Daemon health, readiness, and lifecycle banners"
    },
    {
      "file_path": "Chainworks Forge/Support/P031ThinGraphQLReadBoundary.swift",
      "description": "Core GraphQL read-only client and store boundary"
    },
    {
      "file_path": "Chainworks Forge/ContentView.swift",
      "description": "Top-level shell and navigation routing"
    }
  ],
  "forbidden_patterns": [
    {
      "kind": "MCP_USAGE",
      "patterns": [
        "MCPCommandClient",
        "MCPPolicyRuntime",
        "MCPTransport",
        "MCPToolWrapper"
      ]
    },
    {
      "kind": "GRAPHQL_MUTATIONS",
      "patterns": [
        "mutation",
        "Mutation",
        "GqlMutation"
      ]
    },
    {
      "kind": "LOCAL_WRITES",
      "patterns": [
        "ideas.create",
        "runs.start",
        "runs.cancel",
        "stages.retry",
        "approvals.resolve",
        "steward.run_analysis",
        "RunRepository.insert",
        "RunRepository.update"
      ]
    },
    {
      "kind": "COMMAND_PLUMBING",
      "patterns": [
        "ActionInvocationIdentity",
        "client_command_id",
        "commandReceipt",
        "CommandLegality"
      ]
    }
  ],
  "exclusions": [
    {
      "file_path": "Chainworks Forge/Legacy/",
      "reason": "Legacy code isolated behind CHAINWORKS_THIN_UI_MODE=legacy"
    }
  ]
}
