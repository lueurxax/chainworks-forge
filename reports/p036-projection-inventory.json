{
  "projections": [
    {
      "name": "SidebarLanes",
      "source": "P031RunsHomePresentation",
      "fields": ["waiting", "blocked", "running", "completed"],
      "transformation": "Grouped by status, sorted by freshness"
    },
    {
      "name": "SummaryHeader",
      "source": "P031RunDetailPresentation",
      "fields": ["title", "workflowLabel", "statusLabel", "progressLabel", "pendingApprovalsLabel"],
      "transformation": "Direct mapping with title casing"
    },
    {
      "name": "TimelineEntries",
      "source": ["WorkflowMapProjection.liveTimeline", "WorkflowMapProjection.persistedTimeline"],
      "fields": ["id", "message", "timestamp", "agentID", "isCollapsed"],
      "transformation": "Merged, sorted, 40-entry capped, identity-grouped"
    },
    {
      "name": "InlineApprovals",
      "source": "P031RunDetailPresentation.approvalRows",
      "fields": ["id", "title", "canApprove", "canReject", "deferredState"],
      "transformation": "Actionability checks against model state"
    }
  ]
}