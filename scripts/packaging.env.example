# P042 §10.5 release-host packaging configuration.
#
# Copy this file to `scripts/packaging.env` on the release host and fill
# in the values. `scripts/packaging.env` is NOT committed to the
# repository — it holds release credentials and the resolved Team ID
# for the Developer ID certificate in use.
#
# The file is consumed by `./scripts/test-gate.sh proposal-042-packaging`.
# That lane sources the file with `set -a` so all variables become
# environment variables visible to `xcodebuild` and `xcrun notarytool`.
#
# ── Required ───────────────────────────────────────────────────────────
# Comma-separated allow list of Team IDs considered valid for the
# packaged app + daemon. The release lane extracts the Team ID from the
# signed bundle's code signature (via `codesign -dvvv`) and checks that
# it appears in this list. Multiple IDs are allowed so a team can run
# the same gate on a backup signing identity during certificate
# rollovers.
P042_EXPECTED_TEAM_ID=""

# Absolute path to the Apple Developer account's App-Specific Password
# for notarization. Used by `xcrun notarytool` when submitting the
# exported archive. Leave empty if notarization evidence is provided
# out-of-band via `P042_NOTARIZATION_SUBMISSION_ID`.
P042_NOTARIZATION_APPLE_ID=""
P042_NOTARIZATION_TEAM_ID=""
P042_NOTARIZATION_PASSWORD_KEYCHAIN_PROFILE=""

# ── Optional (computed when unset) ────────────────────────────────────
# Path to a pre-built, signed, and exported .app bundle. If set, the
# lane reuses it and skips `xcodebuild archive` / `-exportArchive`.
# Typical local release-host workflow: unset → lane archives fresh.
# CI workflow: set to the artifact path so archiving happens once
# upstream and the gate only validates.
P042_SIGNED_APP_BUNDLE=""

# Notarization submission ID for the exported archive. If set, the
# lane fetches the notarytool log via `xcrun notarytool log`; if
# unset, the lane submits the archive itself using the
# P042_NOTARIZATION_* variables above.
P042_NOTARIZATION_SUBMISSION_ID=""

# Marker variable that signals "yes, this host is a release host".
# Required as a safety interlock so a developer workstation cannot
# accidentally try to build a release archive.
P042_PACKAGING_RELEASE_HOST="1"
